# Example .env.prod for apps/web
# Copy this to .env.prod, fill in real production values, then run:
#   envage encrypt apps/web --env prod

NEXT_PUBLIC_APP_NAME=MyApp
NEXT_PUBLIC_API_URL=https://api.myapp.com
DATABASE_URL=postgres://produser:CHANGE_ME@prod-db.myapp.com:5432/myapp
AUTH_SECRET=CHANGE_ME_TO_SECURE_SECRET
NODE_ENV=production
