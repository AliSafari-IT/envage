# Example .env.dev for apps/web
# Copy this to .env.dev and fill in your values, then run:
#   envage encrypt apps/web --env dev

NEXT_PUBLIC_APP_NAME=MyApp
NEXT_PUBLIC_API_URL=http://localhost:3001
DATABASE_URL=postgres://user:password@localhost:5432/myapp_dev
AUTH_SECRET=change-me-to-a-random-32-char-string
NODE_ENV=development
