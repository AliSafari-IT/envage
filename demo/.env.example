# Example .env for root
# Copy this .env.example to .env and fill in your values, then run:
# if your .env file is in a app or package, use the relative path to specify the path like so:
#   npx envage encrypt ./example/apps/admin --env root
# Then encrypt the .env file:
#   npx envage encrypt . --env root

NEXT_PUBLIC_APP_NAME=MyApp
NEXT_PUBLIC_API_URL=http://localhost:3001
DATABASE_URL=postgres://user:password@localhost:5432/myapp_dev
AUTH_SECRET=change-me-to-a-random-32-char-string
NODE_ENV=development
